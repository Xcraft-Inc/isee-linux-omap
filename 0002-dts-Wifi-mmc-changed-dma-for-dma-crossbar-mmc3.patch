From 3a45cf9fb3643582f2e6fc2fac45fbd0d620de1f Mon Sep 17 00:00:00 2001
From: spalacios <spalacios@iseebcn.com>
Date: Thu, 15 Feb 2018 13:14:25 +0100
Subject: [PATCH 2/3] dts: Wifi mmc, changed dma for dma-crossbar mmc3

Signed-off-by: spalacios <spalacios@iseebcn.com>
---
 arch/arm/boot/dts/am335x-igep-igep0034-lite.dtsi | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/arch/arm/boot/dts/am335x-igep-igep0034-lite.dtsi b/arch/arm/boot/dts/am335x-igep-igep0034-lite.dtsi
index 3a0c4e9..b755499 100644
--- a/arch/arm/boot/dts/am335x-igep-igep0034-lite.dtsi
+++ b/arch/arm/boot/dts/am335x-igep-igep0034-lite.dtsi
@@ -394,9 +394,9 @@
 
 &mmc3 {
 	status = "okay";
-	//dmas = <&edma 12
-	//	&edma 13>; 
-	//dma-names = "tx", "rx";
+	dmas = <&edma_xbar 12 0 1
+		&edma_xbar 13 0 2>; 
+	dma-names = "tx", "rx";
 	vmmc-supply = <&wlan_en_reg>;
 	bus-width = <4>;
 	pinctrl-names = "default", "sleep";
@@ -406,7 +406,6 @@
 	ti,needs-special-hs-handling;
 	cap-power-off-card;
 	keep-power-in-suspend;
-	//#dma-cells = <2>;
 	#address-cells = <1>;
 	#size-cells = <0>;
 	wlcore: wlcore@0 {
-- 
2.7.4

