#include "omap3-igep0030-common.dtsi"
#include "omap-gpmc-smsc9221.dtsi"


/ {
	model = "IGEP COM MODULE Rev. G (TI OMAP AM/DM37x) SALLEN GUNNEBO BASE BOARD";
	compatible = "isee,omap3-igep0030-rev-g", "ti,omap36xx", "ti,omap3";

	/* Regulator to trigger the WL_EN signal of the Wifi module */
	lbep5clwmc_wlen: regulator-lbep5clwmc-wlen {
		compatible = "regulator-fixed";
		regulator-name = "WIFI_WL_EN";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio5 11 GPIO_ACTIVE_HIGH>;		/* gpio_139 - WL_EN */
		enable-active-high;
	};

	reg_vcc3: vcc3 {
		compatible = "regulator-fixed";
		regulator-name = "3V3_LCD_EN";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio6 26 GPIO_ACTIVE_LOW>;		/* gpio_186 - LCD_EN */
		regulator-always-on;
	};


	reg_5v0: vcc5 {
		compatible = "regulator-fixed";
		regulator-name = "5V";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};


	video_reg: video_reg {
		compatible = "regulator-fixed";
		regulator-name = "fixed-supply";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	beeper: beeper {
		/* 4KHz Piezoelectric buzzer */
		compatible = "gpio-beeper";
		pinctrl-0 = <&pmxbeeper_pins>;
		pinctrl-names = "default";
		gpios = <&gpio5 22 GPIO_ACTIVE_HIGH>;	/* gpio_150 - BUZZER_ON */
	};

	clk20m: clk20m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <20000000>;
	};

	tfp410: encoder {
		compatible = "ti,tfp410";
		pinctrl-0 = <&tfp410_pins>;
		powerdown-gpios = <&gpio1 12 GPIO_ACTIVE_LOW>; /* gpio_12 - DVI_PUP */

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				tfp410_in: endpoint {
					remote-endpoint = <&dpi_out>;
				};
			};

			port@1 {
				reg = <1>;

				tfp410_out: endpoint {
					remote-endpoint = <&dvi_connector_in>;
				};
			};
		};
	};

	dvi0: connector {
		compatible = "dvi-connector";
		label = "dvi";

		digital;

		ddc-i2c-bus = <&i2c3>;

		port {
			dvi_connector_in: endpoint {
				remote-endpoint = <&tfp410_out>;
			};
		};
	};


};

&omap3_pmx_core {
	pinctrl-names = "default";
	pinctrl-0 = <
		&dssdpi_pins
		&canreset_pins
		&lcdenable_pins
		&debug1_pins
		&dinput1_pins
	>;

	dssdpi_pins: pinmux_dssdpi_pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x20d4, PIN_OUTPUT | MUX_MODE0)   /* dss_pclk.dss_pclk */
			OMAP3_CORE1_IOPAD(0x20d6, PIN_OUTPUT | MUX_MODE0)   /* dss_hsync.dss_hsync */
			OMAP3_CORE1_IOPAD(0x20d8, PIN_OUTPUT | MUX_MODE0)   /* dss_vsync.dss_vsync */
			OMAP3_CORE1_IOPAD(0x20da, PIN_OUTPUT | MUX_MODE0)   /* dss_acbias.dss_acbias */
			OMAP3_CORE1_IOPAD(0x20dc, PIN_OUTPUT | MUX_MODE0)   /* dss_data0.dss_data0 */
			OMAP3_CORE1_IOPAD(0x20de, PIN_OUTPUT | MUX_MODE0)   /* dss_data1.dss_data1 */
			OMAP3_CORE1_IOPAD(0x20e0, PIN_OUTPUT | MUX_MODE0)   /* dss_data2.dss_data2 */
			OMAP3_CORE1_IOPAD(0x20e2, PIN_OUTPUT | MUX_MODE0)   /* dss_data3.dss_data3 */
			OMAP3_CORE1_IOPAD(0x20e4, PIN_OUTPUT | MUX_MODE0)   /* dss_data4.dss_data4 */
			OMAP3_CORE1_IOPAD(0x20e6, PIN_OUTPUT | MUX_MODE0)   /* dss_data5.dss_data5 */
			OMAP3_CORE1_IOPAD(0x20e8, PIN_OUTPUT | MUX_MODE0)   /* dss_data6.dss_data6 */
			OMAP3_CORE1_IOPAD(0x20ea, PIN_OUTPUT | MUX_MODE0)   /* dss_data7.dss_data7 */
			OMAP3_CORE1_IOPAD(0x20ec, PIN_OUTPUT | MUX_MODE0)   /* dss_data8.dss_data8 */
			OMAP3_CORE1_IOPAD(0x20ee, PIN_OUTPUT | MUX_MODE0)   /* dss_data9.dss_data9 */
			OMAP3_CORE1_IOPAD(0x20f0, PIN_OUTPUT | MUX_MODE0)   /* dss_data10.dss_data10 */
			OMAP3_CORE1_IOPAD(0x20f2, PIN_OUTPUT | MUX_MODE0)   /* dss_data11.dss_data11 */
			OMAP3_CORE1_IOPAD(0x20f4, PIN_OUTPUT | MUX_MODE0)   /* dss_data12.dss_data12 */
			OMAP3_CORE1_IOPAD(0x20f6, PIN_OUTPUT | MUX_MODE0)   /* dss_data13.dss_data13 */
			OMAP3_CORE1_IOPAD(0x20f8, PIN_OUTPUT | MUX_MODE0)   /* dss_data14.dss_data14 */
			OMAP3_CORE1_IOPAD(0x20fa, PIN_OUTPUT | MUX_MODE0)   /* dss_data15.dss_data15 */
			OMAP3_CORE1_IOPAD(0x20fc, PIN_OUTPUT | MUX_MODE0)   /* dss_data16.dss_data16 */
			OMAP3_CORE1_IOPAD(0x20fe, PIN_OUTPUT | MUX_MODE0)   /* dss_data17.dss_data17 */
			OMAP3_CORE1_IOPAD(0x2100, PIN_OUTPUT | MUX_MODE0)   /* dss_data18.dss_data18 */
			OMAP3_CORE1_IOPAD(0x2102, PIN_OUTPUT | MUX_MODE0)   /* dss_data19.dss_data19 */
			OMAP3_CORE1_IOPAD(0x2104, PIN_OUTPUT | MUX_MODE0)   /* dss_data20.dss_data20 */
			OMAP3_CORE1_IOPAD(0x2106, PIN_OUTPUT | MUX_MODE0)   /* dss_data21.dss_data21 */
			OMAP3_CORE1_IOPAD(0x2108, PIN_OUTPUT | MUX_MODE0)   /* dss_data22.dss_data22 */
			OMAP3_CORE1_IOPAD(0x210a, PIN_OUTPUT | MUX_MODE0)   /* dss_data23.dss_data23 */
		>;
	};

	lbep5clwmc_pins: pinmux_lbep5clwmc_pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x2164, PIN_INPUT | MUX_MODE4)	/* sdmmc2_dat4.gpio_136 - W_IRQ */
			OMAP3_CORE1_IOPAD(0x2166, PIN_OUTPUT | MUX_MODE4)	/* sdmmc2_dat5.gpio_137 - BT_EN */
			OMAP3_CORE1_IOPAD(0x216a, PIN_OUTPUT | MUX_MODE4)	/* sdmmc2_dat7.gpio_139 - WL_EN */
		>;
	};

	canreset_pins: pinmux_canreset_pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x20c8, PIN_OUTPUT_PULLDOWN | MUX_MODE4)	/* gpmc_nbe1.gpio_61 - CAN_RESET */
		>;
	};

	lcdenable_pins: pinmux_lcdenable_pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x21e2, PIN_OUTPUT_PULLDOWN | MUX_MODE4)	/* sys_clkout2.gpio_186 - LCD_EN */
		>;
	};

	debug1_pins: pinmux_debug1_pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x219c, PIN_INPUT_PULLUP | MUX_MODE4)   /* uart3_rts_sd.gpio_164 - DEBUG_1 */
		>;
	};

	dinput1_pins: pinmux_dinput1_pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x20b2, PIN_INPUT_PULLUP | MUX_MODE4)   /* gpmc_ncs2.gpio_53 - DINTPUT1_1V8 */
			OMAP3_CORE1_IOPAD(0x217e, PIN_INPUT_PULLUP | MUX_MODE4)   /* uart1_rts.gpio_149 - DINTPUT3_1V8 */
		>;
	};


	pmxbeeper_pins: pinmux_pmx_beeper_pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x2180, PIN_OUTPUT | MUX_MODE4)		/* uart1_cts.gpio_150 - BUZZER_ON*/
		>;
	};

	leds_pins: pinmux_leds_pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x21be, PIN_OUTPUT | MUX_MODE4)	/* i2c2_scl.gpio_168 */
		>;
	};

	smsc9221_pins: pinmux_smsc9221_pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x20b0, PIN_INPUT_PULLUP | MUX_MODE4)		/* gpmc_ncs1.gpio_52 - ENET0_IRQ */
			OMAP3_CORE1_IOPAD(0x208a, PIN_OUTPUT_PULLUP | MUX_MODE4)	/* gpmc_a9.gpio_42 - ENET0_nRESET */
		>;
	};

	smsc9221two_pins: pinmux_smsc9221two_pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x2088, PIN_INPUT_PULLUP | MUX_MODE4)		/* gpmc_a8.gpio_41 - ENET1_IRQ */
			OMAP3_CORE1_IOPAD(0x208c, PIN_OUTPUT_PULLUP | MUX_MODE4)	/* gpmc_a10.gpio_43 - ENET1_nRESET */
		>;
	};

	uart4_pins: pinmux_uart4_pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x20d0, PIN_OUTPUT | MUX_MODE2)	/* gpmc_wait2.uart4_tx */
			OMAP3_CORE1_IOPAD(0x20d2, PIN_INPUT | MUX_MODE2)	/* gpmc_wait3.uart4_rx */
		>;
	};

	mcspi1_pins: pinmux_mcpsi1_pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x21c8, PIN_INPUT | MUX_MODE0)	/* mcspi1_clk.mcspi1_clk */
			OMAP3_CORE1_IOPAD(0x21ca, PIN_INPUT | MUX_MODE0)	/* mcspi1_clk.mcspi1_simo */
			OMAP3_CORE1_IOPAD(0x21cc, PIN_INPUT | MUX_MODE0)	/* mcspi1_somi.mcspi1_somi */
			OMAP3_CORE1_IOPAD(0x21ce, PIN_INPUT | MUX_MODE0)	/* mcspi1_cs0.mcspi1_cs0 */
			OMAP3_CORE1_IOPAD(0x21d0, PIN_INPUT | MUX_MODE0)	/* mcspi1_cs1.mcspi1_cs1 */
		>;
	};
};

&omap3_pmx_wkup {
	pinctrl-names = "default";
	tsc2046_pins: pinmux_tsc2046_pins {
		pinctrl-single,pins = <
			OMAP3_WKUP_IOPAD(0x2a16, PIN_INPUT_PULLUP | MUX_MODE4)   /* sys_off_mode.gpio_10 - TOUCH_n_PEN_IRQ*/
		>;
	};
};

&omap3_pmx_core2 {
	pinctrl-names = "default";
	pinctrl-0 = <
		&debug2_pins
		&dinput2_pins
		&doutput2_pins
	>;
	
	mcp2515_pins: pinmux_mcp2515_pins {
		pinctrl-single,pins = <
			OMAP3630_CORE2_IOPAD(0x25da, PIN_INPUT_PULLUP | MUX_MODE4)	/* etk_clk.gpio_13 - CAN_IRQ */
		>;
	};
	
	leds2gunnebo_pins: pinmux_leds2gunnebo_pins {
		pinctrl-single,pins = <
			OMAP3630_CORE2_IOPAD(0x25ec, PIN_OUTPUT_PULLUP | MUX_MODE4)	/* etk_d8.gpio_22 - LED_USER1 */
			OMAP3630_CORE2_IOPAD(0x25e6, PIN_OUTPUT_PULLUP | MUX_MODE4)	/* etk_d5.gpio_19 - LED_USER2 */
			OMAP3630_CORE2_IOPAD(0x25e8, PIN_OUTPUT_PULLUP | MUX_MODE4)	/* etk_d6.gpio_20 - LED_USER3 */
		>;
	};

	tfp410_pins: pinmux_tfp410_pins {
		pinctrl-single,pins = <
			OMAP3630_CORE2_IOPAD(0x25d8, PIN_OUTPUT_PULLUP | MUX_MODE4)	/* etk_clk.gpio_12 - DVI_PUP */
		>;
	};

	debug2_pins: pinmux_debug2_pins {
		pinctrl-single,pins = <
			OMAP3630_CORE2_IOPAD(0x25de, PIN_INPUT_PULLUP | MUX_MODE4)   /* etk_d1.gpio_15 - DEBUG_2 */
		>;
	};

	dinput2_pins: pinmux_dinput2_pins {
		pinctrl-single,pins = <
			OMAP3630_CORE2_IOPAD(0x25e4, PIN_INPUT_PULLUP | MUX_MODE4)   /* etk_d4.gpio_18 - DINTPUT2_1V8 */
		>;
	};

	doutput2_pins: pinmux_doutput2_pins {
		pinctrl-single,pins = <
			OMAP3630_CORE2_IOPAD(0x25dc, PIN_OUTPUT | MUX_MODE4)	/* etk_d0.gpio_14 - DOUTPUT1_1V8 */
			OMAP3630_CORE2_IOPAD(0x25ea, PIN_OUTPUT | MUX_MODE4)	/* etk_d7.gpio_21 - DOUTPUT2_1V8 */
			OMAP3630_CORE2_IOPAD(0x25e2, PIN_OUTPUT | MUX_MODE4)	/* etk_d3.gpio_17 - DOUTPUT3_1V8 */
		>;
	};
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pins>;
	status = "ok";
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2_pins>;
	status = "ok";
};

&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart3_pins>;
	status = "ok";
};

&uart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart4_pins>;
	status = "ok";
};

&i2c2 {
	status = "disabled";
};

&i2c3 {
	clock-frequency = <100000>;

	/*
	 * Display monitor features are burnt in the EEPROM
	 * as EDID data.
	 */
	eeprom@51 {
		compatible = "at24,24c01";
		reg = <0x51>;
		pagesize = <8>;
	};
};

&leds {
	pinctrl-names = "default";
	pinctrl-0 = <&leds_pins &leds2_pins &leds2gunnebo_pins>;

	boot {
		label = "omap3:green:boot";
		gpios = <&gpio6 8 GPIO_ACTIVE_HIGH>;
		default-state = "on";
	};
	led_user1 {
		label = "omap3:green:led_user1";
		gpios = <&gpio1 22 GPIO_ACTIVE_HIGH>;
		default-state = "off";
	};
	led_user2 {
		label = "omap3:green:led_user2";
		gpios = <&gpio1 19 GPIO_ACTIVE_HIGH>;
		default-state = "off";
	};
	led_user3 {
		label = "omap3:green:led_user3";
		gpios = <&gpio1 20 GPIO_ACTIVE_HIGH>;
		default-state = "off";
	};
};

&mmc2 {
	pinctrl-names = "default";
	pinctrl-0 = <&mmc2_pins &lbep5clwmc_pins>;
	vmmc-supply = <&lbep5clwmc_wlen>;
	bus-width = <4>;
	ti,non-removable;
	ti,needs-special-hs-handling;
	cap-power-off-card;
	keep-power-in-suspend;
	#dma-cells = <2>;
	#address-cells = <1>;
	#size-cells = <0>;
	wlcore: wlcore@2 {
		compatible = "ti,wl1835";
		reg = <2>;
		interrupt-parent = <&gpio5>;
		interrupts = <8 IRQ_TYPE_LEVEL_HIGH>; /* gpio 136 */
	};
};

&gpmc {
	ranges =  <4 0 0x2b000000 0x01000000>,	/* CS4: 16MB for ethernet 0*/
			  <6 0 0x2d000000 0x01000000>,	/* CS6: 16MB for ethernet 1*/
			  <0 0 0x30000000 0x01000000>;	/* CS0: 16MB for NAND */
	ethernet@gpmc {
		reg = <4 0 0xff>;
		pinctrl-names = "default";
		pinctrl-0 = <&smsc9221_pins>;
		interrupt-parent = <&gpio2>;
		interrupts = <20 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpio2 10 GPIO_ACTIVE_LOW>;
	};
	ethernet1@6,0 {
		reg = <6 0 0xff>;
		compatible = "smsc,lan9221","smsc,lan9115";
		pinctrl-names = "default";
		pinctrl-0 = <&smsc9221two_pins>;

		bank-width = <2>;
		gpmc,mux-add-data;
		gpmc,cs-on-ns = <0>;
		gpmc,cs-rd-off-ns = <42>;
		gpmc,cs-wr-off-ns = <36>;
		gpmc,adv-on-ns = <6>;
		gpmc,adv-rd-off-ns = <12>;
		gpmc,adv-wr-off-ns = <12>;
		gpmc,oe-on-ns = <0>;
		gpmc,oe-off-ns = <42>;
		gpmc,we-on-ns = <0>;
		gpmc,we-off-ns = <36>;
		gpmc,rd-cycle-ns = <60>;
		gpmc,wr-cycle-ns = <54>;
		gpmc,access-ns = <36>;
		gpmc,page-burst-access-ns = <0>;
		gpmc,bus-turnaround-ns = <0>;
		gpmc,cycle2cycle-delay-ns = <0>;
		gpmc,wr-data-mux-bus-ns = <18>;
		gpmc,wr-access-ns = <42>;
		gpmc,cycle2cycle-samecsen;
		gpmc,cycle2cycle-diffcsen;
		vddvario-supply = <&vddvario>;
		vdd33a-supply = <&vdd33a>;
		reg-io-width = <4>;
		smsc,save-mac-address;

		interrupt-parent = <&gpio2>;
		interrupts = <9 0x2>;
		reset-gpios = <&gpio2 11 GPIO_ACTIVE_LOW>;
	};
};

&mcspi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&mcspi1_pins>;

	/* can interface with mcp2515 chip */
	mcp2515@0 {
		reg = <0>;    /* CS0 */
		compatible = "microchip,mcp2515";
		clocks = <&clk20m>;
		spi-max-frequency = <10000000>;
		vdd-supply = <&reg_5v0>;
		vxceiver-supply = <&reg_5v0>;
		interrupt-parent = <&gpio1>;
		interrupts = <13 0x2>;
		pinctrl-names = "default";
		pinctrl-0 = <&mcp2515_pins>;

	};

	/* touch controller interface with tsc2046 chip */
	tsc2046@1 {
		reg = <1>;   /* CS1 */
		compatible = "ti,tsc2046";
		interrupt-parent = <&gpio1>;
		interrupts = <10 0x2>;   /* gpio_10 */
		spi-max-frequency = <1000000>;
		pendown-gpio = <&gpio1 10 GPIO_ACTIVE_HIGH>;
		vcc-supply = <&reg_vcc3>;
		pinctrl-names = "default";
		pinctrl-0 = <&tsc2046_pins>;

		ti,x-min = /bits/ 16 <300>;
		ti,x-max = /bits/ 16 <3000>;
		ti,y-min = /bits/ 16 <600>;
		ti,y-max = /bits/ 16 <3600>;
		ti,x-plate-ohms = /bits/ 16 <80>;
		ti,pressure-max = /bits/ 16 <255>;
		ti,swap-xy;

		wakeup-source;
	};
};


&vpll2 {
	/* Needed for DSS */
	regulator-name = "vdds_dsi";
};

&dss {
	status = "ok";
	vdds_dsi-supply = <&vpll2>;
	vdda_video-supply = <&video_reg>;

	port {
		dpi_out: endpoint {
			remote-endpoint = <&tfp410_in>;
			data-lines = <24>;
		};
	};
};